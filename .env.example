# common
PROJECT_ENVIRONMENT=loc
PROJECT_URL_SCHEME=http
PROJECT_DOMAIN=ai-processing-specifications.loc
PROJECT_DATA_DIR=/data/ai-processing-specifications

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis
REDIS_DATA_DIR="${PROJECT_DATA_DIR}/redis"

# postgres
POSTGRES_HOST=pgbouncer
POSTGRES_PORT=5432
POSTGRES_DATA_DIR="${PROJECT_DATA_DIR}/db"
POSTGRES_USER=ai_processing_specifications
POSTGRES_PASSWORD=ai_processing_specifications
POSTGRES_DB=ai_processing_specifications

# sqlalchemy
SQLALCHEMY_DEBUG=True
SQLALCHEMY_POOL_SIZE=50
SQLALCHEMY_MAX_OVERFLOW=-1
SQLALCHEMY_POOL_RECYCLE=600
SQLALCHEMY_POOL_USE_LIFO=False
SQLALCHEMY_POOL_PRE_PING=True

# MinIO
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# CORS Settings
# Значения буквами: compose передаёт env_file в контейнер как есть, ${VAR} здесь
# не раскроется (интерполяция работает только в самом docker-compose.yml).
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://ai-processing-specifications.loc","https://ai-processing-specifications.loc"]

# backend
BACKEND_DEBUG=True
BACKEND_WORKER_COUNT=2
BACKEND_CONTAINER_COMMAND="--workers ${BACKEND_WORKER_COUNT}"
#BACKEND_CONTAINER_COMMAND="--reload"
BACKEND_PORT=8000
BACKEND_API_PREFIX=/api/v1
BACKEND_BASE_URL="${PROJECT_URL_SCHEME}://${PROJECT_DOMAIN}"

# JWT (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
# Secure-куки требуют HTTPS; для локальной разработки по http — False
JWT_COOKIE_SECURE=False
JWT_COOKIE_DOMAIN=

# OpenAI
OPENAI_API_KEY=sk-...

# ML / Embeddings (локальная модель на CPU)
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
# Ограничение потоков математических вычислений (OpenMP/MKL/BLAS)
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4

# Hugging Face (кэш моделей эмбеддингов)
HF_DATA_DIR="${PROJECT_DATA_DIR}/hf"

# LLM (litellm: provider = openai | ollama)
LLM_PROVIDER=ollama
LLM_OPENAI_MODEL=openai/gpt-4o-mini
LLM_OLLAMA_MODEL=ollama/qwen2.5:7b
LLM_OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=60
