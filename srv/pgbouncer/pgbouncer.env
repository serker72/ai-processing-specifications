# Static pgbouncer settings for edoburu/pgbouncer.
# DB_*, LISTEN_* and AUTH_TYPE are set in docker-compose.yml (they contain secrets).
POOL_MODE=transaction
MAX_CLIENT_CONN=200
DEFAULT_POOL_SIZE=20
MIN_POOL_SIZE=0
RESERVE_POOL_SIZE=5
RESERVE_POOL_MODE=transaction
MAX_DB_CONNECTIONS=100
SERVER_RESET_QUERY=DISCARD ALL
CONNECT_TIMEOUT=15
QUERY_TIMEOUT=0
IDLE_TRANSACTION_TIMEOUT=0
LOG_CONNECTIONS=1
LOG_DISCONNECTIONS=1
LOG_POOLER_ERRORS=1
